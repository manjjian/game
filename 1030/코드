{
	system("cls");
	printf("주사위 케이크 먹기 게임\n\n");
	printf("두 사람이 케이크를 양쪽 끝에서부터\n");
	printf("주사위 눈만큼 먹어 들어갑니다.\n");
	printf("마지막 조각을 먹는 사람이 이깁니다.\n\n");
	printf("주사위 특수 효과 (가끔 숫자와 함께 나옵니다)\n");
	printf("  보너스 : 한 번 더 굴리기\n");
	printf("  폭탄   : 다음 턴 쉬기\n");
	printf("  황금   : %d조각 더 먹기\n", GOLD_EXTRA);
	printf("  얼음   : 상대의 다음 주사위 절반\n\n");
	printf("키 안내\n");
	printf("  R   : 다시 굴리기\n");
