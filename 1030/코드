/*
 * Dice Cake Eating Game - Feature Upgrade (27 features)
 *
 * [Added features]  Search for the F number to find each one in the code
 *  F1  Main menu (start / settings / ranking / rules / exit)
 *  F2  Choose the number of cake pieces (20 / 30 / 40)
 *  F3  Two-dice mode
 *  F4  Play against the computer
 *  F5  Roll to decide who goes first
 *  F6  Dice effect BONUS : roll one more time
 *  F7  Dice effect BOMB  : skip the next turn
 *  F8  ESC returns to the menu
 *  F9  Show turn count / elapsed time
 *  F10 Play again (Y/N)
 *  F11 Win record between the two players
 *  F12 Ranking file (ranking.txt)
 *  F13 Longer names (up to 30 bytes)
 *  F14 Rules menu
 *  F15 Dice effect chance (off / low / normal / high)
 *  F16 Reset the ranking
 *  F17 Computer level (easy / normal / hard)
 *  F18 Spectate mode (COM vs COM)
 *  F19 Best-of-three mode
 *  F20 Turn time limit (auto play after 10 seconds)
 *  F21 Dice effect GOLD  : eat 3 more pieces
 *  F22 Dice effect ICE   : opponent's next roll is halved
 *  F23 Reroll item (once per game, R key)
 *  F24 Pause (P key)
 *  F25 Prevent duplicate names
 *  F26 Fastest win record (best.txt)
 *  F27 Game log file (game_log.txt)
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <time.h>
#include <windows.h>
#include <conio.h>

#define MAX_CAKE        40              /* F2 */
#define NAME_LEN        31              /* F13 */
#define ESC_KEY         27              /* F8 */
#define MAX_RANK        100             /* F12 */
#define RANK_FILE       "ranking.txt"   /* F12 */
#define BEST_FILE       "best.txt"      /* F26 */
#define LOG_FILE        "game_log.txt"  /* F27 */
#define TIME_LIMIT_SEC  10              /* F20 */
#define GOLD_EXTRA      3               /* F21 */

/* Special dice effects (one roll gives at most one) */
#define EF_NONE  0
#define EF_BONUS 1                      /* F6 */
#define EF_BOMB  2                      /* F7 */
#define EF_GOLD  3                      /* F21 */
#define EF_ICE   4                      /* F22 */

/* Game modes */
#define MODE_2P       0
#define MODE_COM      1                 /* F4 */
#define MODE_SPECTATE 2                 /* F18 */

/* Settings (changed in the settings menu) */
int cake_number   = 30;                 /* F2 */
int dice_count    = 1;                  /* F3 */
int mode          = MODE_2P;            /* F4, F18 */
int difficulty    = 1;                  /* F17: 0 easy, 1 normal, 2 hard */
int effect_level  = 2;                  /* F15: 0 off, 1 low, 2 normal, 3 high */
int best_of_three = 0;                  /* F19 */
int time_limit    = 0;                  /* F20 */

/* State used during one game */
int ice_flag[2];                        /* F22: 1 = next roll is halved */
int reroll_left[2];                     /* F23: rerolls left */
time_t game_begin;                      /* F9 */
int paused_total;                       /* F24: paused time is not counted */
FILE *log_fp = NULL;                    /* F27 */

const char *mode_name[]    = { "2인 대전", "컴퓨터 대전", "관전 (COM vs COM)" };
const char *level_name[]   = { "쉬움", "보통", "어려움" };
const char *chance_name[]  = { "끔", "낮음", "보통", "높음" };
const int   effect_chance[] = { 0, 15, 30, 50 };                     /* F15: percent */
const char *effect_name[]  = { "", "보너스", "폭탄", "황금", "얼음" };

void intro_game(void);
int  main_menu(void);
void settings_menu(void);
void input_participant(char user_name[][NAME_LEN]);
int  decide_first(char name[][NAME_LEN]);
int  play_match(char name[][NAME_LEN], int wins[]);
int  play_game(char name[][NAME_LEN], int wins[], int *win_turns);
int  game_control(char name[][NAME_LEN], int condition[], int *left,
                  int user, int *s, int *e, int wins[]);
void roll_dice(int user, int *d1, int *d2);
int  roll_effect(void);
void eat_pieces(int condition[], int *left, int user, int *s, int *e, int count);
void cake_display(char name[][NAME_LEN], int condition[], int left, int s, int e, int wins[]);
int  is_computer(int user);
int  read_key(void);
int  wait_key(int next_user);
void pause_game(void);
int  elapsed_sec(void);
int  load_ranking(char names[][NAME_LEN], int counts[]);
void update_ranking(const char *winner);
void show_ranking(void);
int  update_best(const char *name, int turns);
void gotoxy(int x, int y);

int main(void)
{
	char user_name[2][NAME_LEN];
	int wins[2], winner, choice, again;
	UINT cp = (sizeof("가") == 4) ? 65001 : 949;   /* match the console to the file encoding */

	SetConsoleOutputCP(cp);
	SetConsoleCP(cp);
	srand((unsigned)time(NULL));

	intro_game();
	while (1)
	{
		choice = main_menu();                         /* F1 */
		if (choice == '1')
		{
			input_participant(user_name);
			wins[0] = wins[1] = 0;                    /* F11 */
			do
			{
				winner = play_match(user_name, wins);
				if (winner < 0)                       /* F8 */
					break;
				wins[winner]++;                       /* F11 */
				update_ranking(user_name[winner]);    /* F12 */

				gotoxy(10, 16);
				printf("%s 승리!   전적  %s %d : %d %s",
				       user_name[winner], user_name[0], wins[0], wins[1], user_name[1]);
				gotoxy(10, 18);
				printf("다시 할까요? (Y/N) ");             /* F10 */
				again = toupper(getch());
			} while (again == 'Y');
		}
		else if (choice == '2')
			settings_menu();
		else if (choice == '3')
			show_ranking();                           /* F12, F16, F26 */
		else if (choice == '4')
			intro_game();                             /* F14 */
		else if (choice == '5')
			break;
	}
	system("cls");
	printf("안녕히 가세요!\n");
	return 0;
}

